{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*", "src/**/*.test.ts", "src/test-setup.ts"],
  "compilerOptions": {
    // @vue/tsconfig stops at ES2020 to match Vite's own target and leaves
    // newer built-ins to the project. Vite 7 builds for browsers that all have
    // Object.hasOwn, which is what the lookup tables in src/lib are guarded
    // with, so the library is raised to the version that declares it.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": { "@/*": ["./src/*"] },
    "types": ["vitest/globals"]
  }
}
