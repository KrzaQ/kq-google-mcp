# Copy to .env (gitignored) and fill in. docker-compose.yml reads it as
# env_file, and `make dev-backend` sources it when it exists.

# Path of the SQLite file. /data is the volume in compose; a development run
# out of the checkout uses ./data/gmcp.db, which is also the built-in default.
GMCP_DATABASE=/data/gmcp.db

# Where the server listens inside the container. Compose publishes it on
# 127.0.0.1:13386 and apache proxies the public name to that.
GMCP_BIND=0.0.0.0:8000

# Public origin. Both OIDC and Google redirect URIs and every download link
# derive from it; it is never taken from a request header.
GMCP_PUBLIC_URL=https://google-mcp.int.krzaq.cc

# At least 32 bytes. Signs the session and flow cookies and, via HKDF, seals
# every stored Google refresh token: rotating it invalidates every connection
# and each Google account has to be connected again (`gmcp check-secret`
# reports which ones no longer open).
# openssl rand -base64 48
GMCP_SECRET=

# oidc (default) or dev. dev logs everyone in as one fixed user and is refused
# unless both GMCP_PUBLIC_URL and GMCP_BIND are loopback.
GMCP_AUTH=oidc

# authentik: create an OAuth2/OpenID provider (authorization code,
# confidential, redirect URI ${GMCP_PUBLIC_URL}/api/auth/callback) and an
# application bound to it; the issuer is the application's slug URL.
GMCP_OIDC_ISSUER=https://authentik.krzaq.cc/application/o/gmcp/
GMCP_OIDC_CLIENT_ID=
GMCP_OIDC_CLIENT_SECRET=
# Optional: only members of this authentik group may log in. Leave it unset to
# let any authentik account in — everyone still sees only their own
# connections, tokens and log — or gate the login with an application policy
# in authentik instead.
# GMCP_OIDC_GROUP=gmcp

# The Web application OAuth client from the Google Cloud console (the same
# project as gmail-sender, a new client of type "Web application"), with
# ${GMCP_PUBLIC_URL}/api/google/callback and
# http://localhost:8000/api/google/callback as authorised redirect URIs.
GMCP_GOOGLE_CLIENT_ID=
GMCP_GOOGLE_CLIENT_SECRET=

# Where the Google endpoints are. These are the real ones and want no change;
# the tests point them at wiremock, which is the only reason they exist.
GMCP_GOOGLE_API_BASE=https://www.googleapis.com
GMCP_GOOGLE_OAUTH_BASE=https://oauth2.googleapis.com
GMCP_GOOGLE_ACCOUNTS_BASE=https://accounts.google.com

# `serve` applies pending migrations at startup; set it to 0 to run `gmcp
# migrate` by hand instead.
GMCP_AUTO_MIGRATE=1

# Optional: log filter.
RUST_LOG=info
